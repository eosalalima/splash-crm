# Copy to .env.local and fill securely. Never commit real credentials.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Optional existing Neon Auth user ID, used only by the explicit seed command.
SEED_OWNER_ID=
# Optional Gmail SMTP invitations. Enable Google 2-Step Verification and
# generate an app password; never use your regular Google password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Public HTTPS application origin, never localhost for recipient links.
APP_URL=
